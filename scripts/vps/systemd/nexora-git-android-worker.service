[Unit]
Description=Nexora Git Android background build worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nexora-git/android-builder.conf

[Service]
Type=simple
User=nexora-build
Group=nexora-build
ExecStart=/usr/local/libexec/nexora-git-android-worker
Restart=always
RestartSec=2s
KillMode=control-group
TimeoutStopSec=30s
UMask=0077

Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
OOMScoreAdjust=200
LimitNOFILE=65535
TasksMax=4096

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/nexora-git/android /var/cache/nexora-git/gradle

[Install]
WantedBy=multi-user.target
