# Public GitHub App identifier.
GITHUB_APP_CLIENT_ID=Iv1.example

# CONFIDENTIAL: never commit the real value.
GITHUB_APP_CLIENT_SECRET=replace-me

# Must exactly match a callback URL configured in the GitHub App.
GITHUB_CALLBACK_URL=https://auth.example.com/oauth/callback

# Verified Android App Link return target on the same HTTPS authority.
APP_CALLBACK_URI=https://auth.example.com/oauth/android/callback

PORT=8080
