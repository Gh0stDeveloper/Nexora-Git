[submodule "native/git/vendor/libgit2"]
	path = native/git/vendor/libgit2
	url = https://github.com/libgit2/libgit2.git
[submodule "native/git/vendor/mbedtls"]
	path = native/git/vendor/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "native/git/vendor/tree-sitter"]
	path = native/git/vendor/tree-sitter
	url = https://github.com/tree-sitter/tree-sitter.git
[submodule "native/git/vendor/tree-sitter-kotlin"]
	path = native/git/vendor/tree-sitter-kotlin
	url = https://github.com/fwcd/tree-sitter-kotlin.git
[submodule "native/git/vendor/tree-sitter-java"]
	path = native/git/vendor/tree-sitter-java
	url = https://github.com/tree-sitter/tree-sitter-java.git
[submodule "native/git/vendor/tree-sitter-json"]
	path = native/git/vendor/tree-sitter-json
	url = https://github.com/tree-sitter/tree-sitter-json.git
[submodule "native/git/vendor/tree-sitter-python"]
	path = native/git/vendor/tree-sitter-python
	url = https://github.com/tree-sitter/tree-sitter-python.git
[submodule "native/git/vendor/tree-sitter-javascript"]
	path = native/git/vendor/tree-sitter-javascript
	url = https://github.com/tree-sitter/tree-sitter-javascript.git
[submodule "native/git/vendor/tree-sitter-typescript"]
	path = native/git/vendor/tree-sitter-typescript
	url = https://github.com/tree-sitter/tree-sitter-typescript.git
